generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CLIENT
  PHOTOGRAPHER
  EDITOR
  STUDIO_OWNER
  ADMIN
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  OFFER
  PAYMENT_AND_REFUND
  COOKIES
}

enum ProfileStatus {
  DRAFT
  PUBLISHED
  BLOCKED
}

enum HallStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  PENDING_PLATFORM_FEE
  CONFIRMED
  IN_PROGRESS
  RESCHEDULE_REQUESTED
  RESCHEDULED
  COMPLETED
  CANCELLED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_PROVIDER
  CANCELLED_BY_PLATFORM
  NO_SHOW_CLIENT
  NO_SHOW_PROVIDER
  DECLINED
}

enum BookingPaymentStatus {
  UNPAID
  DEPOSIT_PENDING
  DEPOSIT_PAID
  FINAL_PAYMENT_PENDING
  FULLY_PAID
  REFUNDED
  FAILED
}

enum BookingType {
  FULL_SHOOT
  PHOTOGRAPHER_ONLY
  STUDIO_ONLY
}

enum StudioConfirmationMode {
  PLATFORM_CALENDAR_AUTO
  WHATSAPP_CONFIRMATION
  MANUAL_DASHBOARD_CONFIRMATION
}

enum StudioConfirmationRequestStatus {
  PENDING_STUDIO_CONFIRMATION
  ACCEPTED_BY_STUDIO
  REJECTED_BY_STUDIO
  EXPIRED
  CANCELLED
  CONVERTED_TO_BOOKING
}

enum StudioConfirmationRejectionReason {
  TIME_UNAVAILABLE
  HALL_UNAVAILABLE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  MANUAL
  CLOUDPAYMENTS
  FREEDOM_PAY
  KASPI
  PAYBOX
}

enum PaymentType {
  PLATFORM_FEE
  DEPOSIT
  FINAL_PAYMENT
  REFUND
}

enum SettlementMode {
  PLATFORM_FEE_ONLY
  AGENT_FULL_COLLECTION
}

enum ProviderPaymentStatus {
  NOT_TRACKED
  EXTERNAL_PENDING
  EXTERNAL_PAID
  EXTERNAL_CANCELLED
}

enum PlatformFeeStatus {
  UNPAID
  PAID
  REFUND_REQUESTED
  REFUNDED
  NON_REFUNDABLE
}

enum CancellationReason {
  CLIENT_CHANGED_PLANS
  CLIENT_NO_SHOW
  PROVIDER_CANCELLED
  PROVIDER_NO_SHOW
  WEATHER
  TECHNICAL_ERROR
  DOUBLE_BOOKING
  PLATFORM_ERROR
  OTHER
}

enum PayoutStatus {
  NOT_READY
  PAYOUT_PENDING
  PAID_OUT
  ON_HOLD
  CANCELLED
}

enum NotificationType {
  BOOKING_CREATED
  DEPOSIT_PAID
  FINAL_PAYMENT_REQUESTED
  FULLY_PAID
  BOOKING_CONFIRMED
  BOOKING_DECLINED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  RESCHEDULE_REQUESTED
  REVIEW_CREATED
  PAYMENT_REFUNDED
  ADMIN_NOTICE
}

enum NotificationChannel {
  IN_APP
  MOCK_EMAIL
  MOCK_TELEGRAM
  TELEGRAM
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum TelegramConnectionStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum AlbumMediaType {
  IMAGE
  VIDEO
}

enum MediaProvider {
  CLOUDINARY
  SUPABASE
  LOCAL
}

enum CalendarOwnerType {
  PHOTOGRAPHER
  STUDIO_HALL
}

enum CalendarEventSource {
  PLATFORM_BOOKING
  MANUAL_BUSY
  SYSTEM_HOLD
  TELEGRAM
}

enum CalendarEventStatus {
  BUSY
  CANCELLED
}

enum AvailabilityHoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
}

enum AvailabilityHoldSource {
  BOOKING_FLOW
  TELEGRAM_LEAD
}

enum BookingSource {
  PLATFORM
  TELEGRAM_LEAD
  ADMIN
}

enum BookingLeadSource {
  TELEGRAM
}

enum BookingLeadStatus {
  NEW
  NEEDS_CONFIRMATION
  CONFIRMED_BY_PROVIDER
  LINK_CREATED
  LINK_SENT
  CONVERTED_TO_BOOKING
  EXPIRED
  REJECTED
  CANCELLED
}

enum ExternalProvider {
  TELEGRAM
}

enum ExternalChannelOwnerType {
  PHOTOGRAPHER
  STUDIO
}

enum ExternalMessageStatus {
  RECEIVED
  IGNORED
  PARSED
  NEEDS_CONFIRMATION
  CONFIRMED
  FAILED
}

enum CalendarDraftSource {
  TELEGRAM
}

enum CalendarDraftStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

model User {
  id                         String                      @id @default(cuid())
  name                       String
  email                      String?                     @unique
  emailVerified              DateTime?
  image                      String?
  phone                      String?                     @unique
  phoneVerifiedAt            DateTime?
  passwordHash               String?
  role                       UserRole
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  accounts                   Account[]
  sessions                   Session[]
  photographerProfile        PhotographerProfile?
  studioProfiles             StudioProfile[]
  bookings                   Booking[]                   @relation("ClientBookings")
  notifications              Notification[]
  telegramConnections        TelegramConnection[]
  notificationDeliveryLogs   NotificationDeliveryLog[]
  createdCalendarEvents      CalendarEvent[]             @relation("CalendarEventCreator")
  availabilityHolds          AvailabilityHold[]
  telegramConnectionCodes    TelegramConnectionCode[]
  telegramLoginIntents       TelegramLoginIntent[]             @relation("CompletedTelegramLogin")
  pendingTelegramLoginIntents TelegramLoginIntent[]            @relation("PendingTelegramAccountLink")
  createdCalendarDrafts      CalendarDraft[]             @relation("CalendarDraftCreator")
  confirmedCalendarDrafts    CalendarDraft[]             @relation("CalendarDraftConfirmer")
  cancelledBookings          Booking[]                   @relation("BookingCancelledBy")
  studioConfirmationRequests StudioConfirmationRequest[]
  legalAcceptances           LegalAcceptance[]
}

model LegalAcceptance {
  id              String            @id @default(cuid())
  userId          String
  documentType    LegalDocumentType
  documentVersion String
  source          String            @default("web")
  acceptedAt      DateTime          @default(now())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, documentVersion])
  @@index([userId, acceptedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model TelegramLoginIntent {
  id                      String   @id @default(cuid())
  tokenHash               String   @unique
  telegramSubject         String
  displayName             String
  username                String?
  image                   String?
  phone                   String
  phoneVerifiedAt         DateTime
  expiresAt               DateTime
  completedAt             DateTime?
  userId                  String?
  pendingLinkUserId       String?
  sessionTokenHash        String?  @unique
  sessionTokenExpiresAt   DateTime?
  sessionTokenUsedAt      DateTime?
  createdAt               DateTime @default(now())
  user                    User?    @relation("CompletedTelegramLogin", fields: [userId], references: [id], onDelete: SetNull)
  pendingLinkUser         User?    @relation("PendingTelegramAccountLink", fields: [pendingLinkUserId], references: [id], onDelete: Cascade)

  @@index([telegramSubject, expiresAt])
  @@index([expiresAt])
  @@index([pendingLinkUserId, expiresAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Style {
  id            String                @id @default(cuid())
  name          String
  slug          String                @unique
  description   String
  startingPrice Int
  imageUrl      String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  photographers PhotographerProfile[] @relation("PhotographerStyles")
  bookings      Booking[]
}

model EditorTag {
  id        String                @id @default(cuid())
  name      String
  slug      String                @unique
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  editors   PhotographerProfile[] @relation("EditorTags")
}

model PhotographerProfile {
  id                      String                      @id @default(cuid())
  userId                  String                      @unique
  name                    String
  city                    String
  bio                     String
  avatarUrl               String
  avatarPublicId          String?
  avatarProvider          MediaProvider?
  avatarBytes             Int?
  avatarOriginalBytes     Int?
  avatarWidth             Int?
  avatarHeight            Int?
  avatarFormat            String?
  avatarMediaType         AlbumMediaType              @default(IMAGE)
  hourlyRate              Int
  rating                  Float                       @default(0)
  status                  ProfileStatus               @default(DRAFT)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  styles                  Style[]                     @relation("PhotographerStyles")
  editorTags              EditorTag[]                 @relation("EditorTags")
  portfolioItems          PhotographerPortfolioItem[]
  availabilitySlots       AvailabilitySlot[]
  availabilityRules       AvailabilityRule[]
  calendarEvents          CalendarEvent[]
  availabilityHolds       AvailabilityHold[]
  bookings                Booking[]
  reviews                 Review[]
  externalChannels        ExternalChannel[]
  calendarDrafts          CalendarDraft[]
  bookingLeads            BookingLead[]
  telegramConnectionCodes TelegramConnectionCode[]
}

model PhotographerPortfolioItem {
  id             String                       @id @default(cuid())
  photographerId String
  imageUrl       String
  imagePublicId  String?
  mediaType      AlbumMediaType               @default(IMAGE)
  provider       MediaProvider?
  bytes          Int?
  originalBytes  Int?
  width          Int?
  height         Int?
  format         String?
  coverCropX     Float?
  coverCropY     Float?
  coverCropWidth Float?
  coverCropHeight Float?
  title          String?
  description    String?
  createdAt      DateTime                     @default(now())
  photographer   PhotographerProfile          @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  albumImages    PhotographerPortfolioImage[]
}

model PhotographerPortfolioImage {
  id              String                    @id @default(cuid())
  portfolioItemId String
  imageUrl        String
  imagePublicId   String?
  mediaType       AlbumMediaType            @default(IMAGE)
  provider        MediaProvider?
  bytes           Int?
  originalBytes   Int?
  width           Int?
  height          Int?
  format          String?
  sortOrder       Int                       @default(0)
  createdAt       DateTime                  @default(now())
  portfolioItem   PhotographerPortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  @@index([portfolioItemId, sortOrder])
}

model StudioProfile {
  id                             String                      @id @default(cuid())
  ownerId                        String
  name                           String
  city                           String
  address                        String
  description                    String
  imageUrl                       String?
  imagePublicId                  String?
  imageProvider                  MediaProvider?
  imageBytes                     Int?
  imageOriginalBytes             Int?
  imageWidth                     Int?
  imageHeight                    Int?
  imageFormat                    String?
  imageMediaType                 AlbumMediaType              @default(IMAGE)
  googleMapsUrl                  String?
  googleMapsEmbedUrl             String?
  twoGisUrl                      String?
  twoGisEmbedUrl                 String?
  rules                          String
  confirmationMode               StudioConfirmationMode      @default(PLATFORM_CALENDAR_AUTO)
  whatsappBookingPhone           String?
  whatsappContactName            String?
  whatsappResponseTimeoutMinutes Int                         @default(30)
  whatsappConfirmationEnabled    Boolean                     @default(false)
  status                         ProfileStatus               @default(DRAFT)
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
  owner                          User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  halls                          StudioHall[]
  bookings                       Booking[]
  reviews                        Review[]
  externalChannels               ExternalChannel[]
  bookingLeads                   BookingLead[]
  telegramConnectionCodes        TelegramConnectionCode[]
  confirmationRequests           StudioConfirmationRequest[]
}

model StudioHall {
  id                   String                      @id @default(cuid())
  studioId             String
  name                 String
  description          String
  capacity             Int
  hourlyRate           Int
  imageUrl             String
  imagePublicId        String?
  imageProvider        MediaProvider?
  imageBytes           Int?
  imageOriginalBytes   Int?
  imageWidth           Int?
  imageHeight          Int?
  imageFormat          String?
  imageMediaType       AlbumMediaType              @default(IMAGE)
  amenities            Json
  status               HallStatus                  @default(ACTIVE)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  studio               StudioProfile               @relation(fields: [studioId], references: [id], onDelete: Cascade)
  availabilitySlots    AvailabilitySlot[]
  availabilityRules    AvailabilityRule[]
  calendarEvents       CalendarEvent[]
  availabilityHolds    AvailabilityHold[]
  bookings             Booking[]
  calendarDrafts       CalendarDraft[]
  bookingLeads         BookingLead[]
  galleryImages        StudioHallImage[]
  confirmationRequests StudioConfirmationRequest[]
}

model StudioHallImage {
  id            String         @id @default(cuid())
  studioHallId  String
  imageUrl      String
  imagePublicId String?
  provider      MediaProvider?
  bytes         Int?
  originalBytes Int?
  width         Int?
  height        Int?
  format        String?
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  studioHall    StudioHall     @relation(fields: [studioHallId], references: [id], onDelete: Cascade)

  @@index([studioHallId, sortOrder])
}

model AvailabilitySlot {
  id             String               @id @default(cuid())
  photographerId String?
  studioHallId   String?
  date           DateTime
  startTime      String
  endTime        String
  isAvailable    Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  photographer   PhotographerProfile? @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  studioHall     StudioHall?          @relation(fields: [studioHallId], references: [id], onDelete: Cascade)

  @@index([photographerId])
  @@index([studioHallId])
}

model AvailabilityRule {
  id                    String               @id @default(cuid())
  ownerType             CalendarOwnerType
  photographerProfileId String?
  studioHallId          String?
  weekday               Int
  startTime             String
  endTime               String
  isActive              Boolean              @default(true)
  minDurationMinutes    Int                  @default(60)
  slotStepMinutes       Int                  @default(30)
  bufferBeforeMinutes   Int                  @default(0)
  bufferAfterMinutes    Int                  @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  photographerProfile   PhotographerProfile? @relation(fields: [photographerProfileId], references: [id], onDelete: Cascade)
  studioHall            StudioHall?          @relation(fields: [studioHallId], references: [id], onDelete: Cascade)

  @@index([photographerProfileId, weekday, isActive])
  @@index([studioHallId, weekday, isActive])
}

model CalendarEvent {
  id                    String               @id @default(cuid())
  ownerType             CalendarOwnerType
  photographerProfileId String?
  studioHallId          String?
  bookingId             String?
  source                CalendarEventSource
  status                CalendarEventStatus  @default(BUSY)
  title                 String?
  privateNote           String?
  startTime             DateTime
  endTime               DateTime
  bufferBeforeMinutes   Int                  @default(0)
  bufferAfterMinutes    Int                  @default(0)
  createdById           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  photographerProfile   PhotographerProfile? @relation(fields: [photographerProfileId], references: [id], onDelete: Cascade)
  studioHall            StudioHall?          @relation(fields: [studioHallId], references: [id], onDelete: Cascade)
  booking               Booking?             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdBy             User?                @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([photographerProfileId, status, startTime, endTime])
  @@index([studioHallId, status, startTime, endTime])
  @@index([bookingId, source])
}

model AvailabilityHold {
  id                    String                 @id @default(cuid())
  ownerType             CalendarOwnerType
  photographerProfileId String?
  studioHallId          String?
  bookingId             String?
  bookingLeadId         String?
  userId                String?
  startTime             DateTime
  endTime               DateTime
  source                AvailabilityHoldSource @default(BOOKING_FLOW)
  status                AvailabilityHoldStatus @default(ACTIVE)
  expiresAt             DateTime
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  photographerProfile   PhotographerProfile?   @relation(fields: [photographerProfileId], references: [id], onDelete: Cascade)
  studioHall            StudioHall?            @relation(fields: [studioHallId], references: [id], onDelete: Cascade)
  booking               Booking?               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingLead           BookingLead?           @relation("BookingLeadHolds", fields: [bookingLeadId], references: [id], onDelete: SetNull)
  primaryForBookingLead BookingLead?           @relation("BookingLeadPrimaryHold")
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([photographerProfileId, status, expiresAt, startTime, endTime])
  @@index([studioHallId, status, expiresAt, startTime, endTime])
  @@index([bookingId, status])
  @@index([bookingLeadId, status])
}

model Booking {
  id                        String                     @id @default(cuid())
  bookingNumber             String                     @unique
  clientName                String
  clientEmail               String
  clientPhone               String
  clientId                  String?
  clientComment             String?
  bookingType               BookingType                @default(FULL_SHOOT)
  styleId                   String?
  photographerId            String?
  studioId                  String?
  studioHallId              String?
  shootType                 String?
  shootDescription          String?
  locationType              String?
  city                      String?
  district                  String?
  addressDetails            String?
  peopleCount               Int?
  equipmentNeeded           Json?
  specialRequirements       String?
  rentalPurpose             String?
  needsEquipment            Boolean?
  selectedAmenities         Json?
  date                      DateTime
  startTime                 String
  endTime                   String
  durationHours             Int
  photographerPrice         Int
  studioPrice               Int
  serviceFee                Int
  totalPrice                Int
  settlementMode            SettlementMode             @default(PLATFORM_FEE_ONLY)
  totalServicePrice         Int                        @default(0)
  platformFeeAmount         Int                        @default(0)
  providerAmount            Int                        @default(0)
  platformFeePaidAt         DateTime?
  platformFeeStatus         PlatformFeeStatus          @default(UNPAID)
  providerPaymentStatus     ProviderPaymentStatus      @default(EXTERNAL_PENDING)
  depositAmount             Int                        @default(0)
  paidAmount                Int                        @default(0)
  remainingAmount           Int                        @default(0)
  platformCommission        Int?
  providerFee               Int?
  netPlatformRevenue        Int?
  paymentStatus             BookingPaymentStatus       @default(UNPAID)
  completedAt               DateTime?
  finalPaymentRequestedAt   DateTime?
  fullyPaidAt               DateTime?
  payoutStatus              PayoutStatus?
  payoutAmount              Int?
  rescheduleRequestedAt     DateTime?
  rescheduleComment         String?
  rescheduleCount           Int                        @default(0)
  maxFreeReschedules        Int                        @default(1)
  cancelledAt               DateTime?
  cancelledById             String?
  cancellationReason        CancellationReason?
  cancellationComment       String?
  source                    BookingSource              @default(PLATFORM)
  bookingLeadId             String?                    @unique
  externalSourceProvider    ExternalProvider?
  externalSourceMessageId   String?
  status                    BookingStatus              @default(PENDING)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  style                     Style?                     @relation(fields: [styleId], references: [id])
  photographer              PhotographerProfile?       @relation(fields: [photographerId], references: [id])
  studio                    StudioProfile?             @relation(fields: [studioId], references: [id])
  studioHall                StudioHall?                @relation(fields: [studioHallId], references: [id])
  client                    User?                      @relation("ClientBookings", fields: [clientId], references: [id], onDelete: SetNull)
  cancelledBy               User?                      @relation("BookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  bookingLead               BookingLead?               @relation("BookingSourceLead", fields: [bookingLeadId], references: [id], onDelete: SetNull)
  convertedLead             BookingLead?               @relation("BookingLeadConvertedBooking")
  payments                  Payment[]
  webhookLogs               PaymentWebhookLog[]
  paymentAuditLogs          PaymentAuditLog[]
  calendarEvents            CalendarEvent[]
  availabilityHolds         AvailabilityHold[]
  review                    Review?
  studioConfirmationRequest StudioConfirmationRequest?

  @@index([clientId, createdAt])
  @@index([photographerId, status])
  @@index([studioId, status])
  @@index([paymentStatus, createdAt])
  @@index([source, createdAt])
}

model StudioConfirmationRequest {
  id                              String                             @id @default(cuid())
  studioProfileId                 String
  studioHallId                    String
  bookingId                       String?                            @unique
  clientId                        String?
  bookingType                     BookingType                        @default(STUDIO_ONLY)
  status                          StudioConfirmationRequestStatus    @default(PENDING_STUDIO_CONFIRMATION)
  confirmationToken               String                             @unique
  tokenExpiresAt                  DateTime
  acceptedAt                      DateTime?
  rejectedAt                      DateTime?
  rejectionReason                 StudioConfirmationRejectionReason?
  rejectionComment                String?
  studioName                      String
  hallName                        String
  startTime                       DateTime
  endTime                         DateTime
  durationMinutes                 Int
  totalServicePrice               Int
  platformFeeAmount               Int
  providerAmount                  Int
  clientName                      String?
  clientPhone                     String?
  clientEmail                     String?
  clientComment                   String?
  whatsappMessageText             String?
  whatsappOpenUrl                 String?
  whatsappMessageTextAfterPayment String?
  whatsappOpenUrlAfterPayment     String?
  sentToWhatsappAt                DateTime?
  openedAt                        DateTime?
  rentalPurpose                   String?
  shootDescription                String?
  needsEquipment                  Boolean?
  selectedAmenities               Json?
  peopleCount                     Int?
  specialRequirements             String?
  createdAt                       DateTime                           @default(now())
  updatedAt                       DateTime                           @updatedAt
  studioProfile                   StudioProfile                      @relation(fields: [studioProfileId], references: [id], onDelete: Cascade)
  studioHall                      StudioHall                         @relation(fields: [studioHallId], references: [id], onDelete: Cascade)
  booking                         Booking?                           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  client                          User?                              @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([studioProfileId, status, createdAt])
  @@index([clientId, status, createdAt])
  @@index([studioHallId, startTime, endTime])
  @@index([status, tokenExpiresAt])
}

model Payment {
  id                  String              @id @default(cuid())
  bookingId           String
  amount              Int
  currency            String              @default("KZT")
  status              PaymentStatus       @default(PENDING)
  provider            PaymentProvider     @default(MOCK)
  providerPaymentId   String?             @unique
  providerCheckoutUrl String?
  type                PaymentType         @default(DEPOSIT)
  metadata            Json?
  paidAt              DateTime?
  failedAt            DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  booking             Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  webhookLogs         PaymentWebhookLog[]
  auditLogs           PaymentAuditLog[]

  @@index([bookingId, type, status])
  @@index([provider, status, createdAt])
}

model PaymentWebhookLog {
  id                String          @id @default(cuid())
  provider          PaymentProvider
  eventType         String
  providerPaymentId String?
  paymentId         String?
  bookingId         String?
  payload           Json
  signatureValid    Boolean
  processed         Boolean         @default(false)
  processingError   String?
  createdAt         DateTime        @default(now())
  processedAt       DateTime?
  payment           Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  booking           Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([provider, providerPaymentId])
  @@index([processed, createdAt])
  @@index([bookingId, createdAt])
}

model PaymentAuditLog {
  id        String   @id @default(cuid())
  paymentId String?
  bookingId String
  actorId   String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([paymentId, createdAt])
}

model Review {
  id             String               @id @default(cuid())
  bookingId      String?              @unique
  photographerId String?
  studioId       String?
  clientName     String?
  rating         Int
  comment        String?
  createdAt      DateTime             @default(now())
  booking        Booking?             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  photographer   PhotographerProfile? @relation(fields: [photographerId], references: [id], onDelete: SetNull)
  studio         StudioProfile?       @relation(fields: [studioId], references: [id], onDelete: SetNull)
}

model Notification {
  id           String                    @id @default(cuid())
  userId       String
  type         NotificationType
  title        String
  message      String
  linkUrl      String?
  isRead       Boolean                   @default(false)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryLogs NotificationDeliveryLog[]

  @@index([userId, isRead, createdAt])
  @@index([type])
}

model NotificationDeliveryLog {
  id                String                     @id @default(cuid())
  notificationId    String
  userId            String
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  provider          String?
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  sentAt            DateTime?
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channel, status])
  @@index([userId, channel, status])
}

model TelegramConnection {
  id               String                   @id @default(cuid())
  userId           String
  telegramChatId   String?                  @unique
  telegramUserId   String?
  telegramUsername String?
  status           TelegramConnectionStatus @default(PENDING)
  connectionCode   String?                  @unique
  codeExpiresAt    DateTime?
  connectedAt      DateTime?
  disconnectedAt   DateTime?
  lastMessageAt    DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([connectionCode, codeExpiresAt])
}

model ExternalChannel {
  id                    String                   @id @default(cuid())
  provider              ExternalProvider
  ownerType             ExternalChannelOwnerType
  photographerProfileId String?
  studioProfileId       String?
  telegramChatId        String?
  telegramUserId        String?
  telegramUsername      String?
  title                 String?
  isActive              Boolean                  @default(true)
  connectedAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  photographerProfile   PhotographerProfile?     @relation(fields: [photographerProfileId], references: [id], onDelete: Cascade)
  studioProfile         StudioProfile?           @relation(fields: [studioProfileId], references: [id], onDelete: Cascade)
  messages              ExternalMessage[]
  bookingLeads          BookingLead[]

  @@index([provider, telegramChatId, isActive])
  @@index([photographerProfileId, isActive])
  @@index([studioProfileId, isActive])
}

model ExternalMessage {
  id                String                @id @default(cuid())
  channelId         String?
  provider          ExternalProvider
  externalMessageId String
  telegramChatId    String?
  telegramUserId    String?
  senderName        String?
  senderUsername    String?
  text              String?
  rawPayload        Json
  status            ExternalMessageStatus @default(RECEIVED)
  processedAt       DateTime?
  errorMessage      String?
  createdAt         DateTime              @default(now())
  channel           ExternalChannel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  calendarDrafts    CalendarDraft[]
  bookingLeads      BookingLead[]

  @@unique([provider, externalMessageId])
  @@index([channelId, createdAt])
  @@index([provider, status, createdAt])
  @@index([telegramChatId, createdAt])
}

model CalendarDraft {
  id                    String               @id @default(cuid())
  source                CalendarDraftSource
  ownerType             CalendarOwnerType
  photographerProfileId String?
  studioHallId          String?
  externalMessageId     String?
  title                 String?
  originalText          String
  parsedStartTime       DateTime?
  parsedEndTime         DateTime?
  confidence            Int                  @default(0)
  status                CalendarDraftStatus  @default(PENDING)
  createdById           String?
  confirmedById         String?
  confirmedAt           DateTime?
  rejectedAt            DateTime?
  expiresAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  photographerProfile   PhotographerProfile? @relation(fields: [photographerProfileId], references: [id], onDelete: Cascade)
  studioHall            StudioHall?          @relation(fields: [studioHallId], references: [id], onDelete: Cascade)
  externalMessage       ExternalMessage?     @relation(fields: [externalMessageId], references: [id], onDelete: SetNull)
  createdBy             User?                @relation("CalendarDraftCreator", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedBy           User?                @relation("CalendarDraftConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([photographerProfileId, status, createdAt])
  @@index([studioHallId, status, createdAt])
  @@index([externalMessageId])
  @@index([status, expiresAt])
}

model TelegramConnectionCode {
  id                    String                   @id @default(cuid())
  userId                String
  ownerType             ExternalChannelOwnerType
  photographerProfileId String?
  studioProfileId       String?
  code                  String                   @unique
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime                 @default(now())
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photographerProfile   PhotographerProfile?     @relation(fields: [photographerProfileId], references: [id], onDelete: Cascade)
  studioProfile         StudioProfile?           @relation(fields: [studioProfileId], references: [id], onDelete: Cascade)

  @@index([userId, ownerType, createdAt])
  @@index([code, expiresAt, usedAt])
}

model BookingLead {
  id                      String               @id @default(cuid())
  source                  BookingLeadSource
  provider                ExternalProvider
  externalChannelId       String?
  externalMessageId       String?
  externalSourceMessageId String?
  ownerType               CalendarOwnerType
  bookingType             BookingType
  photographerProfileId   String?
  studioProfileId         String?
  studioHallId            String?
  clientName              String?
  clientPhone             String?
  clientEmail             String?
  clientComment           String?
  originalText            String
  parsedStartTime         DateTime?
  parsedEndTime           DateTime?
  parsedDurationMinutes   Int?
  title                   String?
  notes                   String?
  confidence              Int                  @default(0)
  status                  BookingLeadStatus    @default(NEEDS_CONFIRMATION)
  bookingId               String?              @unique
  availabilityHoldId      String?              @unique
  publicToken             String?              @unique
  publicLinkExpiresAt     DateTime?
  confirmedAt             DateTime?
  convertedAt             DateTime?
  rejectedAt              DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  externalChannel         ExternalChannel?     @relation(fields: [externalChannelId], references: [id], onDelete: SetNull)
  externalMessage         ExternalMessage?     @relation(fields: [externalMessageId], references: [id], onDelete: SetNull)
  photographerProfile     PhotographerProfile? @relation(fields: [photographerProfileId], references: [id], onDelete: Cascade)
  studioProfile           StudioProfile?       @relation(fields: [studioProfileId], references: [id], onDelete: Cascade)
  studioHall              StudioHall?          @relation(fields: [studioHallId], references: [id], onDelete: Cascade)
  booking                 Booking?             @relation("BookingLeadConvertedBooking", fields: [bookingId], references: [id], onDelete: SetNull)
  sourceBooking           Booking?             @relation("BookingSourceLead")
  availabilityHold        AvailabilityHold?    @relation("BookingLeadPrimaryHold", fields: [availabilityHoldId], references: [id], onDelete: SetNull)
  holds                   AvailabilityHold[]   @relation("BookingLeadHolds")

  @@index([photographerProfileId, status, createdAt])
  @@index([studioProfileId, status, createdAt])
  @@index([studioHallId, status, createdAt])
  @@index([publicToken, publicLinkExpiresAt])
  @@index([provider, externalSourceMessageId])
  @@index([status, publicLinkExpiresAt])
}
