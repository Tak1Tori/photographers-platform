DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# Можно использовать CLOUDINARY_URL вместо трех переменных ниже.
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
SUPABASE_STORAGE_ENDPOINT=""
SUPABASE_STORAGE_SECRET=""
SUPABASE_PROJECT_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Set a real provider before enabling payments. Mock payments are local-only and require
# ENABLE_MOCK_PAYMENTS="true" plus a secret in non-production environments.
PAYMENT_PROVIDER=""
ENABLE_MOCK_PAYMENTS=""
MOCK_PAYMENT_WEBHOOK_SECRET=""

CLOUDPAYMENTS_PUBLIC_ID=""
CLOUDPAYMENTS_API_SECRET=""
CLOUDPAYMENTS_WEBHOOK_SECRET=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

FREEDOM_PAY_MERCHANT_ID=""
FREEDOM_PAY_SECRET_KEY=""
FREEDOM_PAY_WEBHOOK_SECRET=""

KASPI_API_KEY=""
KASPI_WEBHOOK_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

TELEGRAM_BOT_TOKEN=""
# Required by the Telegram webhook. Configure this same secret in Telegram's
# setWebhook secret_token parameter; the endpoint rejects all requests without it.
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_BOT_USERNAME=""

# Telegram Login / OpenID Connect. Set these only on the server.
TELEGRAM_OIDC_CLIENT_ID=""
TELEGRAM_OIDC_CLIENT_SECRET=""

# Telegram Gateway OTP. Server-only; never expose this token to the browser.
TELEGRAM_GATEWAY_TOKEN=""

TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="framely_notification_bot"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: protects /api/cron/expire-holds
CRON_SECRET=
